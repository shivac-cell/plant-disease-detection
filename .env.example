# Flask Application Configuration
FLASK_APP=app.py
FLASK_DEBUG=False
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plant_disease_db
DB_USER=plant_app
DB_PASSWORD=replace_with_your_password
DB_POOL_NAME=plant_db_pool
DB_POOL_SIZE=5

# Model Artifact Configuration (Phase 4, optional overrides)
# MODEL_PATH=model/saved_model/plant_disease_model.keras
# CLASS_INDICES_PATH=model/class_indices.json
# MODEL_METADATA_PATH=model/model_metadata.json
# DISEASE_MAPPING_PATH=model/disease_class_mapping.json

# Gemini API Configuration (Supplementary Multimodal Plant & Symptom Analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=10
GEMINI_ENABLED=True
